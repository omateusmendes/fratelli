---
import { highlights } from '@/data/amenities';
import Icon from '@/components/icons/Icon.astro';
---

<section aria-label="Destaques do hotel" class="border-b border-line/70 bg-paper">
  <ul class="container-site grid grid-cols-2 lg:grid-cols-4">
    {
      highlights.map((item, i) => (
        <li
          class:list={[
            'flex flex-col items-center gap-3 px-3 py-7 text-center sm:flex-row sm:justify-center sm:gap-4 sm:text-left lg:py-8',
            i % 2 === 1 && 'border-l border-line',
            i >= 2 && 'border-t border-line lg:border-t-0',
            i === 2 && 'lg:border-l',
          ]}
        >
          <Icon name={item.icon} size={32} strokeWidth={1.25} class="shrink-0 text-gold" />
          <span class="font-serif text-[1.08rem] text-ink">{item.title}</span>
        </li>
      ))
    }
  </ul>
</section>
