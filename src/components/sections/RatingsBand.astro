---
/** Faixa com as notas públicas (Booking e Google) e notas por critério. */
import { reviews, formatScore } from '@/data/reviews';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Button from '@/components/ui/Button.astro';

interface Props {
  showLink?: boolean;
}
const { showLink = true } = Astro.props;
---

<section aria-labelledby="ratings-title" class="bg-sand">
  <div class="container-site grid gap-12 py-16 sm:py-20 lg:grid-cols-12 lg:items-center lg:gap-16 lg:py-24">
    <div class="lg:col-span-5">
      <Eyebrow>Experiência dos hóspedes</Eyebrow>
      <h2 id="ratings-title" class="mt-6 text-h2">Reconhecido por quem já esteve aqui.</h2>
      <p class="mt-5 text-[1.05rem] text-stone">
        Limpeza, atendimento e café da manhã estão entre os aspectos mais valorizados por nossos hóspedes.
      </p>
      {
        showLink && (
          <div class="mt-8">
            <Button href="/avaliacoes/" variant="text" trailingIcon="arrow-right">
              Ver avaliações
            </Button>
          </div>
        )
      }
    </div>

    <div class="lg:col-span-7">
      <div class="grid grid-cols-2 gap-px overflow-hidden rounded-[3px] bg-line">
        <div class="min-w-0 bg-paper p-4 min-[380px]:p-6 sm:p-8">
          <p class="text-[0.75rem] font-bold uppercase tracking-[0.1em] text-muted min-[380px]:tracking-[0.18em] sm:text-[0.78rem]">{reviews.booking.platform}</p>
          <p class="mt-3 font-serif text-[2.9rem] leading-none text-ink min-[380px]:text-[3.4rem] sm:text-[4.2rem]">
            {formatScore(reviews.booking.score)}<span class="ml-1 text-[1.3rem] text-muted">/{reviews.booking.scale}</span>
          </p>
        </div>
        <div class="min-w-0 bg-paper p-4 min-[380px]:p-6 sm:p-8">
          <p class="text-[0.75rem] font-bold uppercase tracking-[0.1em] text-muted min-[380px]:tracking-[0.18em] sm:text-[0.78rem]">{reviews.google.platform}</p>
          <p class="mt-3 font-serif text-[2.9rem] leading-none text-ink min-[380px]:text-[3.4rem] sm:text-[4.2rem]">
            {formatScore(reviews.google.score)}<span class="ml-1 text-[1.3rem] text-muted">/{reviews.google.scale}</span>
          </p>
        </div>
        <dl class="col-span-2 grid grid-cols-3 bg-paper">
          {
            reviews.booking.categories.map((c, i) => (
              <div class:list={['flex min-w-0 flex-col-reverse justify-end px-2 py-5 min-[360px]:px-3 min-[380px]:px-5 sm:p-7', i > 0 && 'border-l border-line']}>
                <dt class="mt-2 text-[0.82rem] text-stone min-[380px]:text-[0.9rem]">{c.label}</dt>
                <dd class="text-gold-metal-deep font-serif text-[1.9rem] leading-none sm:text-[2.3rem]">{formatScore(c.score)}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <p class="mt-4 text-[0.8rem] text-muted">
        Notas públicas consultadas em {reviews.checkedAt}. Critérios por categoria segundo o {reviews.booking.platform}.
      </p>
    </div>
  </div>
</section>
