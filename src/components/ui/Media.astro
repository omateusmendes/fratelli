---
/**
 * Exibe a foto (astro:assets, AVIF/WebP responsivo) quando existir;
 * caso contrário, mostra o placeholder neutro. Para trocar por foto real,
 * basta preencher `image` no arquivo de dados correspondente.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import ImagePlaceholder from './ImagePlaceholder.astro';

interface Props {
  image?: ImageMetadata | undefined;
  alt: string;
  label: string;
  tone?: 'light' | 'dark';
  labelAlign?: 'left' | 'right';
  sizes?: string;
  priority?: boolean;
  class?: string;
}

const {
  image,
  alt,
  label,
  tone = 'light',
  labelAlign = 'left',
  sizes = '(min-width: 1024px) 50vw, 100vw',
  priority = false,
  class: className,
} = Astro.props;
---

{
  image ? (
    <Picture
      src={image}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[...[480, 768, 1080, 1440, 1920].filter((w) => w < image.width), image.width]}
      sizes={sizes}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
      pictureAttributes={{ class: 'block h-full w-full' }}
      class:list={['h-full w-full object-cover', className]}
    />
  ) : (
    <ImagePlaceholder label={label} alt={alt} tone={tone} labelAlign={labelAlign} class={className} />
  )
}
