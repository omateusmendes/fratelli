---
/**
 * Placeholder neutro enquanto as fotos oficiais não chegam.
 * Usa o padrão de arcos e grade do material de apresentação do hotel.
 */
import Icon from '@/components/icons/Icon.astro';

interface Props {
  label: string;
  alt: string;
  tone?: 'light' | 'dark';
  labelAlign?: 'left' | 'right';
  class?: string;
}

const { label, alt, tone = 'light', labelAlign = 'left', class: className } = Astro.props;
const uid = `ph-${Math.random().toString(36).slice(2, 8)}`;
const dark = tone === 'dark';
---

<div
  role="img"
  aria-label={`${alt} (foto em breve)`}
  class:list={[
    'relative isolate overflow-hidden',
    dark ? 'bg-charcoal' : 'bg-sand',
    className,
  ]}
>
  <div
    class="absolute inset-0 -z-10"
    style={dark
      ? 'background: radial-gradient(120% 90% at 78% 18%, #45403a 0%, #2a2829 55%, #1f1d1e 100%);'
      : 'background: radial-gradient(120% 90% at 78% 15%, #fbf6ee 0%, #efe7da 50%, #e3d7c4 100%);'}
  >
  </div>

  <svg
    class:list={['absolute inset-0 -z-10 h-full w-full', dark ? 'text-gold/[0.16]' : 'text-gold/30']}
    aria-hidden="true"
    preserveAspectRatio="xMidYMid slice"
    viewBox="0 0 600 400"
  >
    <defs>
      <pattern id={uid} width="60" height="200" patternUnits="userSpaceOnUse">
        <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
          <line x1="0" y1="0" x2="0" y2="200" vector-effect="non-scaling-stroke"></line>
          <rect x="12" y="30" width="36" height="104" rx="18" vector-effect="non-scaling-stroke"></rect>
          <line x1="0" y1="170" x2="60" y2="170" vector-effect="non-scaling-stroke"></line>
        </g>
      </pattern>
    </defs>
    <rect width="600" height="400" fill={`url(#${uid})`}></rect>
  </svg>

  <p
    class:list={[
      'absolute bottom-3',
      labelAlign === 'right' ? 'right-3' : 'left-3',
      'inline-flex max-w-[calc(100%-1.5rem)] items-center gap-2 rounded-full px-3 py-1.5 text-[0.75rem] font-bold uppercase tracking-[0.18em]',
      dark ? 'bg-ink/70 text-cream/80' : 'bg-paper/85 text-stone',
    ]}
    aria-hidden="true"
  >
    <Icon name="camera" size={13} strokeWidth={1.75} class="shrink-0" />
    <span class="truncate">{label}</span>
  </p>
</div>
