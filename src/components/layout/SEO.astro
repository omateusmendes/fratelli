---
import { hotel, fullAddress } from '@/data/hotel';
import { amenities } from '@/data/amenities';
import { reviews } from '@/data/reviews';
import { rooms } from '@/data/rooms';
import { commonPhotos } from '@/data/photos';
import type { FaqItem } from '@/data/faq';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  /** Nome da página no breadcrumb (páginas internas). */
  breadcrumb?: string | undefined;
  ogImage?: string;
  noindex?: boolean;
  /** Inclui o JSON-LD completo de Hotel (home). */
  hotelSchema?: boolean;
  /** Perguntas exibidas na página (gera JSON-LD FAQPage). */
  faq?: FaqItem[] | undefined;
}

const {
  title,
  description,
  breadcrumb,
  ogImage = '/og-image.jpg',
  noindex = false,
  hotelSchema = false,
  faq,
} = Astro.props;

const site = Astro.site ?? new URL('https://www.fratellipremiumhotel.com.br');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImageUrl = new URL(ogImage, site).href;
const homeUrl = new URL('/', site).href;

/** URL absoluta de uma versão JPG otimizada da foto (para dados estruturados). */
const photoUrl = async (src: ImageMetadata) =>
  new URL((await getImage({ src, width: Math.min(1024, src.width), format: 'jpg' })).src, site).href;

const hotelImages = hotelSchema
  ? await Promise.all(
      [rooms.find((r) => r.featured)?.photos[0]?.src, commonPhotos.recepcao.src, commonPhotos.salaoCafe.src]
        .filter((s): s is ImageMetadata => Boolean(s))
        .map(photoUrl),
    )
  : [];

const roomsLd = hotelSchema
  ? await Promise.all(
      rooms.map(async (room) => ({
        '@type': 'HotelRoom',
        name: room.name,
        description: room.description,
        floorSize: { '@type': 'QuantitativeValue', value: room.size, unitCode: 'MTK' },
        bed: {
          '@type': 'BedDetails',
          numberOfBeds: Number.parseInt(room.beds, 10) || 1,
          typeOfBed: room.beds.replace(/^\d+\s*/, ''),
        },
        occupancy: { '@type': 'QuantitativeValue', maxValue: room.guests },
        ...(room.photos[0] ? { image: await photoUrl(room.photos[0].src) } : {}),
      })),
    )
  : [];

const hotelLd = {
  '@context': 'https://schema.org',
  '@type': 'Hotel',
  '@id': `${homeUrl}#hotel`,
  name: hotel.name,
  description: hotel.description,
  url: homeUrl,
  image: hotelImages.length ? hotelImages : ogImageUrl,
  logo: ogImageUrl,
  containsPlace: roomsLd,
  telephone: hotel.phone.e164,
  ...(hotel.email ? { email: hotel.email } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: hotel.address.street,
    addressLocality: hotel.address.city,
    addressRegion: hotel.address.state,
    ...(hotel.address.postalCode ? { postalCode: hotel.address.postalCode } : {}),
    addressCountry: hotel.address.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: hotel.geo.lat, longitude: hotel.geo.lng },
  hasMap: hotel.googleMapsUrl,
  checkinTime: hotel.schedule.checkInISO,
  checkoutTime: hotel.schedule.checkOutISO,
  amenityFeature: amenities.map((a) => ({
    '@type': 'LocationFeatureSpecification',
    name: a.schemaName,
    value: true,
  })),
  ...(reviews.booking.reviewCount
    ? {
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: reviews.booking.score,
          bestRating: reviews.booking.scale,
          worstRating: 1,
          reviewCount: reviews.booking.reviewCount,
        },
      }
    : {}),
  ...(hotel.instagram ? { sameAs: [hotel.instagram] } : {}),
};

const breadcrumbLd = breadcrumb
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Início', item: homeUrl },
        { '@type': 'ListItem', position: 2, name: breadcrumb, item: canonical },
      ],
    }
  : null;

const faqLd = faq?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    }
  : null;

const jsonLd = [hotelSchema ? hotelLd : null, breadcrumbLd, faqLd].filter(Boolean);
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content="website" />
<meta property="og:locale" content="pt_BR" />
<meta property="og:site_name" content={hotel.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/jpeg" />
<meta
  property="og:image:alt"
  content={`${hotel.name}: suíte com cama de casal e o título “Seu descanso tem endereço em Elói Mendes”. ${fullAddress}.`}
/>
<meta name="twitter:image:alt" content={`${hotel.name} — ${fullAddress}`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

{jsonLd.map((data) => <script type="application/ld+json" is:inline set:html={JSON.stringify(data)} />)}
