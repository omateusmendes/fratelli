---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import { pageHeroPhotos } from '@/data/heroes';
import Media from '@/components/ui/Media.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Button from '@/components/ui/Button.astro';
import Icon, { type IconName } from '@/components/icons/Icon.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import { reviews, formatScore } from '@/data/reviews';
import { buildWhatsAppUrl } from '@/lib/whatsapp';
import { commonPhotos } from '@/data/photos';

const [staff, cleaning] = reviews.booking.categories;

const facts = [
  { value: formatScore(staff.score), label: `nota para os funcionários no ${reviews.booking.platform}` },
  { value: formatScore(cleaning.score), label: `nota em limpeza no ${reviews.booking.platform}` },
  { value: '28–40', unit: 'm²', label: 'de área por acomodação' },
  { value: '24', unit: 'h', label: 'de recepção todos os dias' },
];

const profiles: { icon: IconName; title: string; text: string; items: string[] }[] = [
  {
    icon: 'briefcase',
    title: 'Viagens a trabalho',
    text: 'Uma base tranquila e prática para quem tem agenda cheia.',
    items: ['Wi-Fi gratuito em toda a propriedade', 'Estacionamento privativo gratuito', 'Café da manhã antes dos compromissos', 'Serviço de passar roupas'],
  },
  {
    icon: 'heart',
    title: 'Momentos de descanso',
    text: 'Conforto e tranquilidade para aproveitar a cidade e a região sem pressa.',
    items: ['Suíte com banheira de hidromassagem', 'Lounge compartilhado e terraço', 'Restaurante com culinária brasileira', 'Limpeza diária das acomodações'],
  },
];
---

<BaseLayout
  title="O hotel | Fratelli Premium Hotel — Elói Mendes, MG"
  description="Conheça o Fratelli Premium Hotel: acomodações confortáveis, atendimento dedicado e serviços essenciais em um bairro tranquilo de Elói Mendes, Minas Gerais."
  breadcrumb="O hotel"
>
  <PageHero
    photo={pageHeroPhotos.sobre}
    crumb="O hotel"
    eyebrow="Sobre o hotel"
    title="Uma estadia pensada para o seu bem-estar."
    lead="Cada detalhe contribui para uma experiência de hospedagem agradável, do primeiro contato ao check-out."
  />

  <section aria-labelledby="story-title" class="bg-cream">
    <div class="container-site grid gap-12 py-20 sm:py-24 lg:grid-cols-12 lg:items-center lg:gap-16 lg:py-28">
      <div class="lg:col-span-6">
        <div class="aspect-[4/5] overflow-hidden sm:aspect-[4/3] lg:aspect-[4/5]">
          <Media image={commonPhotos.recepcao.src} alt={commonPhotos.recepcao.alt} label="Recepção" sizes="(min-width: 1024px) 50vw, 100vw" class="h-full w-full" />
        </div>
      </div>
      <div class="lg:col-span-6">
        <Eyebrow>Bem-vindo ao Fratelli</Eyebrow>
        <h2 id="story-title" class="mt-6 text-h2">Acolhimento em um bairro tranquilo.</h2>
        <div class="prose-hotel mt-6 text-[1.08rem] text-stone">
          <p>
            No Fratelli Premium Hotel, cada detalhe contribui para uma experiência de hospedagem agradável. Localizado no
            Jardim Paraíso, um bairro tranquilo de Elói Mendes, o hotel oferece acomodações confortáveis, atendimento dedicado e serviços essenciais para
            quem viaja a trabalho ou lazer.
          </p>
          <p>
            São três categorias de acomodação, café da manhã em estilo buffet, Wi-Fi e estacionamento gratuitos e uma
            recepção que funciona 24 horas, pronta para orientar você durante toda a estadia.
          </p>
        </div>
        <div class="mt-9 flex flex-wrap gap-3">
          <Button href="/acomodacoes/" variant="dark">Ver acomodações</Button>
          <Button href={buildWhatsAppUrl()} variant="outline" icon="whatsapp">Falar com a recepção</Button>
        </div>
      </div>
    </div>
  </section>

  <section aria-label="O Fratelli em números" class="border-y border-line bg-paper">
    <dl class="container-site grid grid-cols-2 lg:grid-cols-4">
      {
        facts.map((f, i) => (
          <div
            class:list={[
              'flex flex-col-reverse justify-end gap-2 px-2 py-10 sm:px-6 lg:py-14',
              i % 2 === 1 && 'border-l border-line',
              i >= 2 && 'border-t border-line lg:border-t-0',
              i === 2 && 'lg:border-l',
            ]}
          >
            <dt class="text-[0.95rem] text-stone">{f.label}</dt>
            <dd class="font-serif text-[2.6rem] leading-none text-ink sm:text-[3.2rem]">
              {f.value}
              {f.unit && <span class="text-[1.4rem] text-gold-dark">{f.unit}</span>}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section aria-labelledby="profiles-title" class="bg-cream">
    <div class="container-site py-20 sm:py-24 lg:py-28">
      <div class="max-w-2xl">
        <Eyebrow>Para cada viagem</Eyebrow>
        <h2 id="profiles-title" class="mt-6 text-h2">A trabalho ou a lazer, você se sente em casa.</h2>
      </div>
      <div class="mt-14 grid gap-6 lg:grid-cols-2">
        {
          profiles.map((p) => (
            <article class="flex flex-col border border-line bg-paper p-7 sm:p-10">
              <Icon name={p.icon} size={30} strokeWidth={1.25} class="text-gold" />
              <h3 class="mt-6 text-h3">{p.title}</h3>
              <p class="mt-3 text-[1.02rem] text-stone">{p.text}</p>
              <ul class="mt-7 grid gap-3 border-t border-line pt-7">
                {p.items.map((item) => (
                  <li class="flex items-start gap-3 text-[1rem] text-charcoal">
                    <span class="mt-[0.6em] h-px w-4 shrink-0 bg-gold" aria-hidden="true" />
                    {item}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
